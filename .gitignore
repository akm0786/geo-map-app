# ============================================================
# .gitignore — Files and folders to exclude from Git
# ============================================================

# --- Node.js Dependencies ---
# The node_modules folder is HUGE (hundreds of MBs) and can
# be recreated anytime with `npm install`. Never commit it.
node_modules/
geo-map-app/node_modules/

# --- Build Output ---
# The dist/ folder is generated by `npm run build`.
# It can be recreated anytime, so no need to track it.
dist/
geo-map-app/dist/

# --- Environment Variables ---
# .env files may contain secrets (API keys, DB passwords).
# NEVER commit these to a public repo.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
geo-map-app/.env
geo-map-app/.env.*

# --- Editor & OS Files ---
# These are auto-generated by your code editor or OS.
# They're specific to your machine and not useful to others.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
# Log files generated during development or npm operations.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Package Manager Lock Files (optional) ---
# We keep package-lock.json but ignore others
yarn.lock
pnpm-lock.yaml

# --- Misc ---
*.local
.cache/
